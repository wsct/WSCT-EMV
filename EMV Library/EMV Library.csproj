<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<Version>3.4.1</Version>
	</PropertyGroup>

	<PropertyGroup>
		<PackageId>WSCT.EMV</PackageId>
		<Description>EMV Library implementation for WSCT.</Description>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>

	<PropertyGroup>
		<AssemblyName>WSCT.EMV</AssemblyName>
		<RootNamespace>WSCT.EMV</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="Dictionary.EMVTag.xml">
			<Visible>True</Visible>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Pack>True</Pack>
			<PackageCopyToOutput>True</PackageCopyToOutput>
		</Content>
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Portable.BouncyCastle" />
		<PackageReference Include="WSCT.Core" />
		<PackageReference Include="WSCT.Helpers" />
	</ItemGroup>
</Project>