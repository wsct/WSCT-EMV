<Project Sdk="Microsoft.NET.Sdk.Razor">
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<VersionPrefix>1.0.0</VersionPrefix>
		<VersionSuffix>alpha</VersionSuffix>
	</PropertyGroup>

	<PropertyGroup>
		<PackageId>WSCT.GUI.Plugins.EMV.Personalization</PackageId>
		<Description>Plugin allowing the personalization of an EMV card (especially the EMV Applet made for ENSICAEN practice work).</Description>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>

	<PropertyGroup>
		<AssemblyName>Plugin.EMV.Personalization</AssemblyName>
		<RootNamespace>WSCT.GUI.Plugins.EMV.Personalization</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<Content Update="emv-personalization\emv-card-data.json">
			<Visible>True</Visible>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Pack>True</Pack>
			<PackageCopyToOutput>True</PackageCopyToOutput>
		</Content>
		<Content Update="emv-personalization\emv-card-model.json">
			<Visible>True</Visible>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Pack>True</Pack>
			<PackageCopyToOutput>True</PackageCopyToOutput>
		</Content>
		<Content Update="emv-personalization\emv-icc-context.json">
			<Visible>True</Visible>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Pack>True</Pack>
			<PackageCopyToOutput>True</PackageCopyToOutput>
		</Content>
		<Content Update="emv-personalization\emv-issuer-context.json">
			<Visible>True</Visible>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Pack>True</Pack>
			<PackageCopyToOutput>True</PackageCopyToOutput>
		</Content>
		<Content Update="pse-personalization\pse-card-data.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Visible>True</Visible>
			<PackageCopyToOutput>True</PackageCopyToOutput>
			<Pack>True</Pack>
		</Content>
		<Content Update="pse-personalization\pse-card-model.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Visible>True</Visible>
			<PackageCopyToOutput>True</PackageCopyToOutput>
			<Pack>True</Pack>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<PackageReference Include="WSCT.Core" />
		<PackageReference Include="WSCT.GUI.Plugins" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\EMV Library\EMV Library.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Resources\Lang.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Lang.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Resources\Lang.resx">
			<Generator>PublicResXFileCodeGenerator</Generator>
			<LastGenOutput>Lang.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>
</Project>
