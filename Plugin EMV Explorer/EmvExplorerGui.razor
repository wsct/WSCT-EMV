<div class="container-fluid px-0">
    @if (!SharedData.IsValidChannel)
    {
        <div class="alert alert-warning d-flex align-items-center py-2 px-3 small mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <span>No active smart card channel. Connect to a card in WSCT GUI to enable EMV commands.</span>
        </div>
    }

    @if (Session.Notification is not null)
    {
        <div class="alert @Session.Notification.AlertClass alert-dismissible fade show py-2 px-3 small mb-3" role="alert">
            <strong>@Session.Notification.Title:</strong> @Session.Notification.Message
            <button type="button" class="btn-close btn-sm" aria-label="Close" @onclick="Session.ClearNotification"></button>
        </div>
    }

    <div class="row g-3">
        <!-- Left Column: EMV Transaction Actions -->
        <div class="col-xl-4 col-lg-5">
            <div class="d-flex flex-column gap-2">

                <!-- Application Selection -->
                <div class="card shadow-sm border-light">
                    <div class="card-header bg-white fw-bold small d-flex justify-content-between align-items-center py-2">
                        <span><i class="bi bi-search me-1 text-primary"></i>Application Selection</span>
                        <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" title="Reset EMV session" @onclick="Session.ResetSession">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </button>
                    </div>
                    <div class="card-body bg-light p-2">
                        <div class="input-group input-group-sm mb-2">
                            <select class="form-select form-select-sm font-monospace" @bind="Session.SelectedPseName">
                                @foreach (var pse in Session.SupportedPses)
                                {
                                    <option value="@pse.Name">@pse.Name</option>
                                }
                            </select>
                            <button type="button" class="btn btn-primary btn-sm" @onclick="Session.SelectPse" disabled="@(!SharedData.IsValidChannel)">
                                Select PSE
                            </button>
                        </div>
                        <button type="button" class="btn btn-outline-primary btn-sm w-100" @onclick="Session.ExplicitDiscoveryOfAids" disabled="@(!SharedData.IsValidChannel)">
                            <i class="bi bi-list-ul me-1"></i>Explicit Discovery of AIDs
                        </button>
                    </div>
                </div>

                <!-- Initiate Application Processing -->
                <div class="card shadow-sm border-light">
                    <div class="card-header bg-white fw-bold small py-2">
                        <i class="bi bi-play-circle me-1 text-primary"></i>Initiate Application Processing
                    </div>
                    <div class="card-body bg-light p-2">
                        <div class="input-group input-group-sm mb-2">
                            <select class="form-select form-select-sm font-monospace" @bind="Session.SelectedApplicationAid" disabled="@(!Session.CanSelectAid)">
                                @if (Session.DiscoveredApplications.Count == 0)
                                {
                                    <option value="">(No AID discovered)</option>
                                }
                                @foreach (var app in Session.DiscoveredApplications)
                                {
                                    <option value="@app.Aid">@app.Aid</option>
                                }
                            </select>
                            <button type="button" class="btn btn-primary btn-sm" @onclick="Session.SelectAid" disabled="@(!SharedData.IsValidChannel || !Session.CanSelectAid)">
                                Select AID
                            </button>
                        </div>
                        <button type="button" class="btn btn-primary btn-sm w-100" @onclick="Session.GetProcessingOptions" disabled="@(!SharedData.IsValidChannel || !Session.CanGetProcessingOptions)">
                            Get Processing Options
                        </button>
                    </div>
                </div>

                <!-- Read Application Data -->
                <div class="card shadow-sm border-light">
                    <div class="card-header bg-white fw-bold small py-2">
                        <i class="bi bi-file-earmark-text me-1 text-primary"></i>Read Application Data
                    </div>
                    <div class="card-body bg-light p-2 d-flex flex-column gap-2">
                        <button type="button" class="btn btn-primary btn-sm w-100" @onclick="Session.ReadApplicationData" disabled="@(!SharedData.IsValidChannel || !Session.CanReadRecords)">
                            Read Application Data
                        </button>
                        <button type="button" class="btn btn-outline-primary btn-sm w-100" @onclick="Session.GetData" disabled="@(!SharedData.IsValidChannel || !Session.CanGetData)">
                            Get Data
                        </button>
                    </div>
                </div>

                <!-- Offline Data Authentication -->
                <div class="card shadow-sm border-light">
                    <div class="card-header bg-white fw-bold small py-2">
                        <i class="bi bi-shield-check me-1 text-primary"></i>Offline Data Authentication
                    </div>
                    <div class="card-body bg-light p-2">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text">Un.Number</span>
                            <input type="text"
                                   class="form-control form-control-sm font-monospace @(IsValidHex(Session.InternalAuthenticateUnpredictableNumber) ? "" : "is-invalid")"
                                   maxlength="8"
                                   @bind="Session.InternalAuthenticateUnpredictableNumber"
                                   @bind:event="oninput"
                                   disabled="@(!Session.CanInternalAuthenticate)" />
                            <button type="button" class="btn btn-primary btn-sm" @onclick="Session.InternalAuthenticate" disabled="@(!SharedData.IsValidChannel || !Session.CanInternalAuthenticate)">
                                Internal Auth
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Cardholder Verification -->
                <div class="card shadow-sm border-light">
                    <div class="card-header bg-white fw-bold small py-2">
                        <i class="bi bi-person-check me-1 text-primary"></i>Cardholder Verification
                    </div>
                    <div class="card-body bg-light p-2 d-flex flex-column gap-2">
                        <button type="button" class="btn btn-outline-primary btn-sm w-100" @onclick="Session.GetChallenge" disabled="@(!SharedData.IsValidChannel || !Session.CanGetChallenge)">
                            Get Challenge
                        </button>
                        <div class="d-flex align-items-center gap-2">
                            <div class="form-check form-switch mb-0 text-nowrap">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="chkPinEntryUsed"
                                       checked="@Session.PinEntryUsed"
                                       @onchange="OnPinEntryUsedChanged"
                                       disabled="@(!Session.CanVerifyCardholder)" />
                                <label class="form-check-label small" for="chkPinEntryUsed">Plain text PIN:</label>
                            </div>
                            <input type="password"
                                   class="form-control form-control-sm font-monospace"
                                   maxlength="12"
                                   @bind="Session.PinEntry"
                                   disabled="@(!Session.CanVerifyCardholder || !Session.PinEntryUsed)" />
                        </div>
                        <div class="input-group input-group-sm">
                            <select class="form-select form-select-sm" @bind="Session.SelectedCvmIndex" disabled="@(!Session.CanVerifyCardholder)">
                                @if (Session.CvmRules.Count == 0)
                                {
                                    <option value="0">(No CVM list)</option>
                                }
                                @for (var i = 0; i < Session.CvmRules.Count; i++)
                                {
                                    var index = i;
                                    <option value="@index">@Session.CvmRules[index].CvmCode</option>
                                }
                            </select>
                            <button type="button" class="btn btn-primary btn-sm" @onclick="Session.VerifyCardholder" disabled="@(!SharedData.IsValidChannel || !Session.CanVerifyCardholder)">
                                Verify
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Card Action Analysis -->
                <div class="card shadow-sm border-light">
                    <div class="card-header bg-white fw-bold small py-2">
                        <i class="bi bi-key me-1 text-primary"></i>Card Action Analysis
                    </div>
                    <div class="card-body bg-light p-2 d-flex flex-column gap-2">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text">Un.Number</span>
                            <input type="text"
                                   class="form-control form-control-sm font-monospace @(IsValidHex(Session.Ac1UnpredictableNumber) ? "" : "is-invalid")"
                                   maxlength="8"
                                   @bind="Session.Ac1UnpredictableNumber"
                                   @bind:event="oninput"
                                   disabled="@(!Session.CanGenerateAc1)" />
                        </div>
                        <div class="input-group input-group-sm">
                            <select class="form-select form-select-sm" @bind="Session.SelectedAc1Type" disabled="@(!Session.CanGenerateAc1)">
                                @foreach (CryptogramType acType in Enum.GetValues<CryptogramType>())
                                {
                                    <option value="@acType">@acType</option>
                                }
                            </select>
                            <button type="button" class="btn btn-primary btn-sm" @onclick="Session.GenerateAc1" disabled="@(!SharedData.IsValidChannel || !Session.CanGenerateAc1)">
                                Generate AC
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Issuer Authentication (Placeholder) -->
                <div class="card shadow-sm border-light">
                    <div class="card-header bg-white fw-bold small d-flex justify-content-between align-items-center py-2">
                        <span><i class="bi bi-bank me-1 text-secondary"></i>Issuer Authentication</span>
                        <span class="badge bg-secondary-subtle text-secondary">Not implemented</span>
                    </div>
                    <div class="card-body bg-light p-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm w-100" @onclick='() => Session.NotifyNotYetImplemented("External Authenticate")' disabled>
                            External Authenticate
                        </button>
                    </div>
                </div>

                <!-- Completion (Placeholder) -->
                <div class="card shadow-sm border-light">
                    <div class="card-header bg-white fw-bold small d-flex justify-content-between align-items-center py-2">
                        <span><i class="bi bi-check2-circle me-1 text-secondary"></i>Completion</span>
                        <span class="badge bg-secondary-subtle text-secondary">Not implemented</span>
                    </div>
                    <div class="card-body bg-light p-2">
                        <div class="input-group input-group-sm">
                            <select class="form-select form-select-sm" disabled>
                                @foreach (CryptogramType acType in Enum.GetValues<CryptogramType>())
                                {
                                    <option value="@acType">@acType</option>
                                }
                            </select>
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick='() => Session.NotifyNotYetImplemented("Generate AC2")' disabled>
                                Generate AC
                            </button>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- Right Column: Inspection Tabs -->
        <div class="col-xl-8 col-lg-7">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white pb-0">
                    <ul class="nav nav-tabs card-header-tabs flex-wrap small">
                        <li class="nav-item">
                            <button type="button" class="nav-link @(_activeTab == "emv" ? "active fw-bold" : "")" @onclick='() => _activeTab = "emv"'>
                                EMV Application
                            </button>
                        </li>
                        <li class="nav-item">
                            <button type="button" class="nav-link @(_activeTab == "pse" ? "active fw-bold" : "")" @onclick='() => _activeTab = "pse"'>
                                PSE
                            </button>
                        </li>
                        <li class="nav-item">
                            <button type="button" class="nav-link @(_activeTab == "keys" ? "active fw-bold" : "")" @onclick='() => _activeTab = "keys"'>
                                Public Keys
                            </button>
                        </li>
                        <li class="nav-item">
                            <button type="button" class="nav-link @(_activeTab == "auth" ? "active fw-bold" : "")" @onclick='() => _activeTab = "auth"'>
                                Authentication
                            </button>
                        </li>
                        <li class="nav-item">
                            <button type="button" class="nav-link @(_activeTab == "tvr" ? "active fw-bold" : "")" @onclick='() => _activeTab = "tvr"'>
                                TVR live
                            </button>
                        </li>
                        <li class="nav-item">
                            <button type="button" class="nav-link @(_activeTab == "cardlog" ? "active fw-bold" : "")" @onclick='() => _activeTab = "cardlog"'>
                                EMV Card Log
                            </button>
                        </li>
                        <li class="nav-item">
                            <button type="button" class="nav-link @(_activeTab == "logs" ? "active fw-bold" : "")" @onclick='() => _activeTab = "logs"'>
                                Detailed Logs
                            </button>
                        </li>
                        <li class="nav-item">
                            <button type="button" class="nav-link @(_activeTab == "params" ? "active fw-bold" : "")" @onclick='() => _activeTab = "params"'>
                                Parameters
                            </button>
                        </li>
                    </ul>
                </div>

                <div class="card-body">
                    @if (_activeTab == "emv")
                    {
                        <div class="d-flex justify-content-end gap-2 mb-2">
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => Session.ExpandAllEmvNodes(true)" disabled="@(Session.EmvApplicationTreeNodes.Count == 0)">
                                <i class="bi bi-arrows-expand me-1"></i>Expand All
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => Session.ExpandAllEmvNodes(false)" disabled="@(Session.EmvApplicationTreeNodes.Count == 0)">
                                <i class="bi bi-arrows-collapse me-1"></i>Collapse All
                            </button>
                        </div>
                        @if (Session.EmvApplicationTreeNodes.Count == 0)
                        {
                            <p class="text-muted small mb-0">Select an EMV application to view decoded TLV data.</p>
                        }
                        else
                        {
                            <div class="border rounded bg-light p-2 overflow-auto" style="max-height: 650px;">
                                <ul class="list-unstyled mb-0">
                                    @foreach (var node in Session.EmvApplicationTreeNodes)
                                    {
                                        <TlvTreeNode Node="node" />
                                    }
                                </ul>
                            </div>
                        }
                    }
                    else if (_activeTab == "pse")
                    {
                        <div class="d-flex justify-content-end gap-2 mb-2">
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => Session.ExpandAllPseNodes(true)" disabled="@(Session.PseTreeNodes.Count == 0)">
                                <i class="bi bi-arrows-expand me-1"></i>Expand All
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => Session.ExpandAllPseNodes(false)" disabled="@(Session.PseTreeNodes.Count == 0)">
                                <i class="bi bi-arrows-collapse me-1"></i>Collapse All
                            </button>
                        </div>
                        @if (Session.PseTreeNodes.Count == 0)
                        {
                            <p class="text-muted small mb-0">Select a PSE to inspect the Payment System Environment.</p>
                        }
                        else
                        {
                            <div class="border rounded bg-light p-2 overflow-auto" style="max-height: 650px;">
                                <ul class="list-unstyled mb-0">
                                    @foreach (var node in Session.PseTreeNodes)
                                    {
                                        <TlvTreeNode Node="node" />
                                    }
                                </ul>
                            </div>
                        }
                    }
                    else if (_activeTab == "keys")
                    {
                        <div class="d-flex flex-column gap-3">
                            <!-- Certification Authority -->
                            <div class="card border-light bg-light">
                                <div class="card-header bg-white fw-bold small py-2">Certification Authority</div>
                                <div class="card-body p-2">
                                    <div class="row g-2 mb-2">
                                        <div class="col-md-4">
                                            <label class="form-label small mb-0">AID</label>
                                            <input type="text" class="form-control form-control-sm font-monospace" value="@Session.PublicKeys.Aid" readonly />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small mb-0">RID</label>
                                            <input type="text" class="form-control form-control-sm font-monospace" value="@Session.PublicKeys.Rid" readonly />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label small mb-0">CA Index</label>
                                            <input type="text" class="form-control form-control-sm font-monospace" value="@Session.PublicKeys.CaIndex" readonly />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label small mb-0">Exponent</label>
                                            <input type="text" class="form-control form-control-sm font-monospace" value="@Session.PublicKeys.CaExponent" readonly />
                                        </div>
                                    </div>
                                    <div>
                                        <label class="form-label small mb-0">Modulus</label>
                                        <textarea class="form-control form-control-sm font-monospace" rows="3" readonly>@Session.PublicKeys.CaModulus</textarea>
                                    </div>
                                </div>
                            </div>

                            <!-- Issuer Public Key -->
                            <div class="card border-light bg-light">
                                <div class="card-header bg-white fw-bold small py-2">Issuer Public Key</div>
                                <div class="card-body p-2 d-flex flex-column gap-2">
                                    <div>
                                        <label class="form-label small mb-0">Recovered Data from Issuer Public Key Certificate</label>
                                        <textarea class="form-control form-control-sm font-monospace" rows="3" readonly>@Session.PublicKeys.IssuerRecoveredData</textarea>
                                    </div>
                                    <div class="row g-2">
                                        <div class="col-md-9">
                                            <label class="form-label small mb-0">Hash Result</label>
                                            <input type="text" class="form-control form-control-sm font-monospace" value="@Session.PublicKeys.IssuerHashResult" readonly />
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label small mb-0">Exponent</label>
                                            <input type="text" class="form-control form-control-sm font-monospace" value="@Session.PublicKeys.IssuerExponent" readonly />
                                        </div>
                                    </div>
                                    <div>
                                        <label class="form-label small mb-0">Modulus</label>
                                        <textarea class="form-control form-control-sm font-monospace" rows="3" readonly>@Session.PublicKeys.IssuerModulus</textarea>
                                    </div>
                                </div>
                            </div>

                            <!-- ICC Public Key -->
                            <div class="card border-light bg-light">
                                <div class="card-header bg-white fw-bold small py-2">ICC Public Key</div>
                                <div class="card-body p-2 d-flex flex-column gap-2">
                                    <div>
                                        <label class="form-label small mb-0">Recovered Data from ICC Public Key Certificate</label>
                                        <textarea class="form-control form-control-sm font-monospace" rows="3" readonly>@Session.PublicKeys.IccRecoveredData</textarea>
                                    </div>
                                    <div class="row g-2">
                                        <div class="col-md-9">
                                            <label class="form-label small mb-0">Hash Result</label>
                                            <input type="text" class="form-control form-control-sm font-monospace" value="@Session.PublicKeys.IccHashResult" readonly />
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label small mb-0">Exponent</label>
                                            <input type="text" class="form-control form-control-sm font-monospace" value="@Session.PublicKeys.IccExponent" readonly />
                                        </div>
                                    </div>
                                    <div>
                                        <label class="form-label small mb-0">Modulus</label>
                                        <textarea class="form-control form-control-sm font-monospace" rows="3" readonly>@Session.PublicKeys.IccModulus</textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else if (_activeTab == "auth")
                    {
                        <ul class="nav nav-pills nav-sm mb-3 small">
                            <li class="nav-item">
                                <button type="button" class="nav-link py-1 px-3 @(_authSubTab == "sda" ? "active" : "")" @onclick='() => _authSubTab = "sda"'>
                                    Static (SDA)
                                </button>
                            </li>
                            <li class="nav-item">
                                <button type="button" class="nav-link py-1 px-3 @(_authSubTab == "dda" ? "active" : "")" @onclick='() => _authSubTab = "dda"'>
                                    Dynamic (DDA)
                                </button>
                            </li>
                            <li class="nav-item">
                                <button type="button" class="nav-link py-1 px-3 @(_authSubTab == "cda" ? "active" : "")" @onclick='() => _authSubTab = "cda"'>
                                    Combined (CDA)
                                </button>
                            </li>
                        </ul>

                        @if (_authSubTab == "sda")
                        {
                            <h6 class="small fw-bold">Signed Data</h6>
                            <SignedDataTable Items="Session.SdaSignedData" />

                            <div class="card border-light bg-light mt-3">
                                <div class="card-header bg-white fw-bold small py-2">Authentication Data</div>
                                <div class="card-body p-2 d-flex flex-column gap-2">
                                    <div>
                                        <label class="form-label small mb-0">Recovered Data from Signed Static Application Data</label>
                                        <textarea class="form-control form-control-sm font-monospace" rows="3" readonly>@Session.Sda.RecoveredData</textarea>
                                    </div>
                                    <div class="row g-2">
                                        <div class="col-md-8">
                                            <label class="form-label small mb-0">Hash Result</label>
                                            <input type="text" class="form-control form-control-sm font-monospace" value="@Session.Sda.HashResult" readonly />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small mb-0">Data Authentication Code</label>
                                            <input type="text" class="form-control form-control-sm font-monospace" value="@Session.Sda.DataAuthenticationCode" readonly />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        else if (_authSubTab == "dda")
                        {
                            <h6 class="small fw-bold">Signed Data</h6>
                            <SignedDataTable Items="Session.DdaSignedData" />

                            <div class="card border-light bg-light mt-3">
                                <div class="card-header bg-white fw-bold small py-2">Authentication Data</div>
                                <div class="card-body p-2 d-flex flex-column gap-2">
                                    <div>
                                        <label class="form-label small mb-0">Recovered Data from Signed Dynamic Application Data</label>
                                        <textarea class="form-control form-control-sm font-monospace" rows="3" readonly>@Session.Dda.RecoveredData</textarea>
                                    </div>
                                    <div class="row g-2">
                                        <div class="col-md-8">
                                            <label class="form-label small mb-0">Hash Result</label>
                                            <input type="text" class="form-control form-control-sm font-monospace" value="@Session.Dda.HashResult" readonly />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small mb-0">ICC Dynamic Data</label>
                                            <input type="text" class="form-control form-control-sm font-monospace" value="@Session.Dda.IccDynamicData" readonly />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <h6 class="small fw-bold">Signed Data</h6>
                            <SignedDataTable Items="Session.CdaSignedData" />
                        }
                    }
                    else if (_activeTab == "tvr")
                    {
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="card border-light bg-light h-100">
                                    <div class="card-header bg-white fw-bold small py-2">TVR Byte 1</div>
                                    <div class="card-body p-2 d-flex flex-column gap-1 small">
                                        <TvrBitRow Label="Offline Data Authentication not performed" IsSet="Session.Tvr.OfflineDataAuthenticationNotPerformed" />
                                        <TvrBitRow Label="SDA failed" IsSet="Session.Tvr.SdaFailed" />
                                        <TvrBitRow Label="ICC Data Missing" IsSet="Session.Tvr.IccDataMissing" />
                                        <TvrBitRow Label="Card appears on terminal exception file" IsSet="Session.Tvr.TerminalExceptionFile" />
                                        <TvrBitRow Label="DDA failed" IsSet="Session.Tvr.DdaFailed" />
                                        <TvrBitRow Label="CDA failed" IsSet="Session.Tvr.CdaFailed" />
                                        <TvrBitRow Label="RFU" IsRfu="true" />
                                        <TvrBitRow Label="RFU" IsRfu="true" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card border-light bg-light h-100">
                                    <div class="card-header bg-white fw-bold small py-2">TVR Byte 2</div>
                                    <div class="card-body p-2 d-flex flex-column gap-1 small">
                                        <TvrBitRow Label="ICC and terminal have different versions" IsSet="Session.Tvr.IccAndTerminalVersionsDifferent" />
                                        <TvrBitRow Label="Expired application" IsSet="Session.Tvr.ExpiredApplication" />
                                        <TvrBitRow Label="Application not yet effective" IsSet="Session.Tvr.NotYetEffectiveApplication" />
                                        <TvrBitRow Label="Requested service not allowed for card" IsSet="Session.Tvr.ServiceNotAllowed" />
                                        <TvrBitRow Label="New card" IsSet="Session.Tvr.NewCard" />
                                        <TvrBitRow Label="RFU" IsRfu="true" />
                                        <TvrBitRow Label="RFU" IsRfu="true" />
                                        <TvrBitRow Label="RFU" IsRfu="true" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card border-light bg-light h-100">
                                    <div class="card-header bg-white fw-bold small py-2">TVR Byte 3</div>
                                    <div class="card-body p-2 d-flex flex-column gap-1 small">
                                        <TvrBitRow Label="Cardholder verification was not successful" IsSet="Session.Tvr.CardholderVerificationFailed" />
                                        <TvrBitRow Label="Unrecognised CVM" IsSet="Session.Tvr.UnrecognisedCvm" />
                                        <TvrBitRow Label="PIN Try Limit exceeded" IsSet="Session.Tvr.PinTryLimitExceeded" />
                                        <TvrBitRow Label="PIN entry required and PIN pad not present" IsSet="Session.Tvr.PinpadError" />
                                        <TvrBitRow Label="PIN entry required, but PIN was not entered" IsSet="Session.Tvr.PinNotEntered" />
                                        <TvrBitRow Label="Online PIN entered" IsSet="Session.Tvr.OnlinePinEntered" />
                                        <TvrBitRow Label="RFU" IsRfu="true" />
                                        <TvrBitRow Label="RFU" IsRfu="true" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card border-light bg-light h-100">
                                    <div class="card-header bg-white fw-bold small py-2">TVR Byte 4</div>
                                    <div class="card-body p-2 d-flex flex-column gap-1 small">
                                        <TvrBitRow Label="Transaction exceed floor limit" IsSet="Session.Tvr.TransactionExceedFloorLimit" />
                                        <TvrBitRow Label="Lower consecutive offline limit exceeded" IsSet="Session.Tvr.LowerConsecutiveOfflineLimitExceeded" />
                                        <TvrBitRow Label="Upper consecutive offline limit exceeded" IsSet="Session.Tvr.UpperConsecutiveOfflineLimitExceeded" />
                                        <TvrBitRow Label="Transaction selected randomly for online processing" IsSet="Session.Tvr.TransactionRandomlySelectedOnline" />
                                        <TvrBitRow Label="Merchant forced transaction online" IsSet="Session.Tvr.MerchantForcedTransactionOnline" />
                                        <TvrBitRow Label="RFU" IsRfu="true" />
                                        <TvrBitRow Label="RFU" IsRfu="true" />
                                        <TvrBitRow Label="RFU" IsRfu="true" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card border-light bg-light h-100">
                                    <div class="card-header bg-white fw-bold small py-2">TVR Byte 5</div>
                                    <div class="card-body p-2 d-flex flex-column gap-1 small">
                                        <TvrBitRow Label="Default TDOL used" IsSet="Session.Tvr.DefaultTdolUsed" />
                                        <TvrBitRow Label="Issuer authentication failed" IsSet="Session.Tvr.IssuerAuthenticationFailed" />
                                        <TvrBitRow Label="Script processing failed before final GENERATE AC" IsSet="Session.Tvr.ScriptProcessingFailedBeforeGenerateAC" />
                                        <TvrBitRow Label="Script processing failed after final GENERATE AC" IsSet="Session.Tvr.ScriptProcessingFailedAfterGenerateAC" />
                                        <TvrBitRow Label="RFU" IsRfu="true" />
                                        <TvrBitRow Label="RFU" IsRfu="true" />
                                        <TvrBitRow Label="RFU" IsRfu="true" />
                                        <TvrBitRow Label="RFU" IsRfu="true" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else if (_activeTab == "cardlog")
                    {
                        <div class="card border-light bg-light mb-3">
                            <div class="card-header bg-white fw-bold small d-flex justify-content-between align-items-center py-2">
                                <span>Log File Information</span>
                                <span class="badge @(Session.CardLog.IsPresent ? "bg-success" : "bg-secondary")">
                                    @(Session.CardLog.IsPresent ? "Log File Present" : "Not Detected")
                                </span>
                            </div>
                            <div class="card-body p-2">
                                <div class="row g-2 align-items-end mb-2">
                                    <div class="col-md-2">
                                        <label class="form-label small mb-0">SFI</label>
                                        <input type="text" class="form-control form-control-sm font-monospace" value="@Session.CardLog.SfiHex" readonly />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label small mb-0">Number of records</label>
                                        <input type="text" class="form-control form-control-sm font-monospace" value="@Session.CardLog.LengthHex" readonly />
                                    </div>
                                    <div class="col-md-7 d-flex justify-content-end gap-2">
                                        <button type="button" class="btn btn-primary btn-sm" @onclick="Session.ReadCardLog" disabled="@(!SharedData.IsValidChannel || !Session.CanReadCardLog)">
                                            <i class="bi bi-journal-text me-1"></i>Read Records
                                        </button>
                                        <button type="button" class="btn btn-success btn-sm" @onclick="SaveCardLogAsync" disabled="@(!Session.CardLog.CanSave)">
                                            <i class="bi bi-download me-1"></i>Save EMV Card Log
                                        </button>
                                    </div>
                                </div>
                                <div>
                                    <label class="form-label small mb-0">Log Format</label>
                                    <textarea class="form-control form-control-sm font-monospace" rows="2" readonly>@Session.CardLog.LogFormatText</textarea>
                                </div>
                            </div>
                        </div>

                        <div class="table-responsive border rounded">
                            <table class="table table-hover table-sm font-monospace small mb-0">
                                <thead class="table-light">
                                    <tr>
                                        @if (Session.CardLog.Columns.Count == 0)
                                        {
                                            <th>Log Records</th>
                                        }
                                        else
                                        {
                                            @foreach (var col in Session.CardLog.Columns)
                                            {
                                                <th>@col</th>
                                            }
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Session.CardLog.Rows.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="@Math.Max(1, Session.CardLog.Columns.Count)" class="text-muted text-center py-3">
                                                No log records loaded.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var row in Session.CardLog.Rows)
                                        {
                                            <tr>
                                                @foreach (var cell in row)
                                                {
                                                    <td>@cell</td>
                                                }
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else if (_activeTab == "logs")
                    {
                        <div class="d-flex justify-content-end gap-2 mb-2">
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="Session.ClearDetailedLogs" disabled="@(Session.DetailedLogs.Count == 0)">
                                <i class="bi bi-trash me-1"></i>Clear
                            </button>
                            <button type="button" class="btn btn-success btn-sm" @onclick="SaveDetailedLogsAsync" disabled="@(Session.DetailedLogs.Count == 0)">
                                <i class="bi bi-download me-1"></i>Save Detailed Logs
                            </button>
                        </div>
                        <div class="border rounded bg-light p-2 font-monospace small overflow-auto" style="height: 600px; white-space: pre-wrap;">
                            @if (Session.DetailedLogs.Count == 0)
                            {
                                <span class="text-muted">Detailed EMV execution logs will appear here.</span>
                            }
                            else
                            {
                                @foreach (var entry in Session.DetailedLogs)
                                {
                                    if (entry.Kind == EmvLogEntryKind.Header)
                                    {
                                        <div class="fw-bold text-dark mt-2 mb-1 border-bottom pb-1">@entry.Text</div>
                                    }
                                    else if (entry.Kind == EmvLogEntryKind.Highlight)
                                    {
                                        <div class="text-primary">@entry.Text</div>
                                    }
                                    else if (entry.Kind == EmvLogEntryKind.Error)
                                    {
                                        <div class="text-danger">@entry.Text</div>
                                    }
                                    else
                                    {
                                        <div>@entry.Text</div>
                                    }
                                }
                            }
                        </div>
                    }
                    else if (_activeTab == "params")
                    {
                        <div class="card border-light bg-light mb-3">
                            <div class="card-header bg-white fw-bold small py-2">Tags Locations</div>
                            <div class="card-body p-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="chkTagAidInFci" @bind="Session.SearchTagAidInFci" />
                                    <label class="form-check-label small" for="chkTagAidInFci">Search for AID in FCI</label>
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-info py-2 px-3 small mb-0" role="alert">
                            <i class="bi bi-info-circle-fill me-2"></i>
                            <strong>Warning:</strong> Note that modifying these parameters will break conformity with base EMV specifications.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
